# ==========================================
# OrganEase Backend Environment Template
# ==========================================

# Server Listening Port
PORT=5000

# MongoDB Database Connection String
# Local: mongodb://127.0.0.1:27017/organ_ease
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE=mongodb://127.0.0.1:27017/organ_ease

# JWT Authentication Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Braintree Payment Gateway Credentials
BRAINTREE_MERCHANT_ID=your_braintree_merchant_id
BRAINTREE_PUBLIC_KEY=your_braintree_public_key
BRAINTREE_PRIVATE_KEY=your_braintree_private_key
